# 运行环境
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 英科 dataportal（本服务对外暴露 /api/dataportal/invoke 供海康调用）
# 同时本服务需要主动调用英科接口时使用以下地址
INKEY_BASE_URL=http://192.168.32.86:1025
INKEY_USERNAME=HKSJSB
INKEY_PASSWORD=HKSJSB123
INKEY_INV_ORG_ID=1

# 海康视觉中控平台（本服务主动查询配置/检测数据）
HK_BASE_URL=http://TODO-HIK-HOST:TODO-HIK-PORT
HK_AUTH_TOKEN=
HK_REQUEST_TIMEOUT=10

# 默认车间代码（可在任务中覆盖）
DEFAULT_WORKSHOP=HBN1

# 定时任务 cron（APScheduler CronTrigger 表达式）
CONFIG_SYNC_CRON=0 */30 * * * *
DETECTION_SYNC_CRON=5 0 * * * *

# Ticket 缓存有效期（秒），待确认实际有效期后调整
TICKET_TTL_SECONDS=1800
