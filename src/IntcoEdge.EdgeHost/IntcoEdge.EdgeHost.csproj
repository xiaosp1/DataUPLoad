<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IntcoEdge.EdgeHost</RootNamespace>
    <AssemblyName>IntcoEdge.EdgeHost</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationTitle>英科边缘数据 EdgeHost</ApplicationTitle>
    <Description>IntcoEdge v0.3 EdgeHost 主进程：接收视觉数据 + REST API + 嵌入 Web UI</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntcoEdge.Common\IntcoEdge.Common.csproj" />
    <!-- W-A5: SQLite 仓储 / 连接工厂 -->
    <ProjectReference Include="..\IntcoEdge.Db\IntcoEdge.Db.csproj" />
  </ItemGroup>

  <!-- W-B1：集成 Web UI（Vue 3 大屏）。
       - Microsoft.AspNetCore.StaticFiles 已在 Web SDK 内置，保留显式声明以便阅读
       - SpaServices 备用，便于 v0.4 SPA fallback 改写（H5 history 模式） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices" Version="3.0.0" />
  </ItemGroup>

  <!-- W-B2：把 Vue 3 build 产物（前端 npm run build 输出）随 EdgeHost 一起发布。
       - wwwroot 目录由 src/IntcoEdge.WebUI 的 vite build 直接写出（outDir = ../IntcoEdge.EdgeHost/wwwroot）
       - PreserveNewest：仅在源文件较新时覆盖，避免每次 build 都全量复制 -->
  <ItemGroup>
    <None Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
