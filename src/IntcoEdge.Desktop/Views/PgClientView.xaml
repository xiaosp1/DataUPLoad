<UserControl x:Class="IntcoEdge.Desktop.Views.PgClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🗄️ PG 客户端（SQLite 浏览器）— 数据库编辑工具"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- 数据库连接 -->
        <GroupBox Grid.Row="1" Header="数据库连接" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="数据库文件：" VerticalAlignment="Center"/>
                <TextBox  Grid.Column="1" x:Name="DbPathBox" VerticalAlignment="Center"
                          Text="E:\DEMO\数据采集\src\IntcoEdge.Db\data\intco.db"/>
                <Button   Grid.Column="2" Content="浏览..." Click="OnBrowse"/>
                <Button   Grid.Column="3" Content="连接" Click="OnConnect"/>
                <Button   Grid.Column="4" Content="断开" Click="OnDisconnect"/>
                <TextBlock Grid.Column="5" x:Name="ConnStatusText" Text="未连接" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- 表选择 -->
        <GroupBox Grid.Row="2" Header="表列表（双击加载数据）" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" x:Name="TableList" SelectionChanged="OnTableChanged"
                         MouseDoubleClick="OnTableDblClick" Height="100"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="⟳ 刷新表列表" Click="OnRefreshTables"/>
                    <Button Content="📥 加载当前选中表" Click="OnLoadCurrentTable"/>
                    <Button Content="💾 保存修改" Click="OnSaveChanges"/>
                    <Button Content="▶ 执行 SQL" Click="OnExecSql"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 数据表 / SQL 编辑 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="数据（双击单元格可直接编辑）">
                <DataGrid x:Name="DataGridView"
                          SelectionUnit="Cell"
                          SelectionMode="Extended"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"/>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="SQL 控制台">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="SqlBox"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             Text="SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                        <Button Content="执行" Click="OnExecSql"/>
                        <Button Content="清空" Click="OnClearSql"/>
                        <Button Content="→ 加载到数据表" Click="OnLoadSqlToGrid"/>
                    </StackPanel>
                    <TextBox Grid.Row="2" x:Name="SqlLogBox" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             Background="#FAFAFA"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 底部状态 -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="FooterText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
